{
  "input": "D:\\qianrushi\\\u667a\u80fd\u4e50\u8c31\u8f85\u52a9\u7cfb\u7edf_\u79bb\u7ebf\u8bed\u97f3\u8bc6\u522b\u6a21\u5757\u8bbe\u8ba1\u6587\u6863.docx",
  "fonts_by_char_count": {
    "Calibri": 2855
  },
  "direct_run_formatting_runs": 103,
  "direct_paragraph_formatting_paragraphs": 69,
  "heading_like_paragraphs_not_heading_style": [
    {
      "para_index": 6,
      "text": "\u2022 \u8bed\u97f3\u91c7\u96c6\uff1a\u901a\u8fc7 INMP441 \u83b7\u53d6 16 kHz \u5355\u58f0\u9053\u6570\u5b57\u97f3\u9891\uff0c\u4e3a\u540e\u7eed\u79bb\u7ebf\u8bc6\u522b\u63d0\u4f9b\u8fde\u7eed PCM \u6570\u636e\u3002",
      "style": "Normal"
    },
    {
      "para_index": 7,
      "text": "\u2022 \u97f3\u9891\u524d\u7aef\uff1a\u5229\u7528 ESP-SR AFE \u5b8c\u6210\u8bed\u97f3\u6d3b\u52a8\u68c0\u6d4b\uff08VAD\uff09\u548c\u566a\u58f0\u6291\u5236\uff0c\u964d\u4f4e\u9759\u97f3\u6bb5\u4e0e\u73af\u5883\u566a\u58f0\u5bf9\u8bc6\u522b\u7ed3\u679c\u7684\u5f71\u54cd\u3002",
      "style": "Normal"
    },
    {
      "para_index": 8,
      "text": "\u2022 \u5524\u9192\u68c0\u6d4b\uff1a\u4f7f\u7528 WakeNet \u8bc6\u522b\u201c\u4f60\u597d\u5c0f\u667a\u201d\uff0c\u53ea\u6709\u68c0\u6d4b\u5230\u5524\u9192\u8bcd\u540e\u624d\u8fdb\u5165\u547d\u4ee4\u8bc6\u522b\u9636\u6bb5\u3002",
      "style": "Normal"
    },
    {
      "para_index": 9,
      "text": "\u2022 \u547d\u4ee4\u8bc6\u522b\uff1a\u4f7f\u7528\u4e2d\u6587 MultiNet \u8bc6\u522b\u4e03\u7c7b\u89c4\u8303\u547d\u4ee4\u53ca\u5176\u5e38\u7528\u540c\u4e49\u8868\u8fbe\u3002",
      "style": "Normal"
    },
    {
      "para_index": 10,
      "text": "\u2022 \u7ed3\u679c\u8f93\u51fa\uff1a\u5c06\u8bc6\u522b\u5230\u7684\u547d\u4ee4\u6620\u5c04\u4e3a\u56fa\u5b9a\u6570\u5b57 ID\uff0c\u5e76\u4ee5\u72ec\u7acb\u7eaf\u6570\u5b57\u884c\u8f93\u51fa\uff0c\u4fbf\u4e8e\u603b\u7cfb\u7edf\u76f4\u63a5\u89e3\u6790\u3002",
      "style": "Normal"
    },
    {
      "para_index": 12,
      "text": "\u56fe 3.X-1  \u79bb\u7ebf\u8bed\u97f3\u8bc6\u522b\u6a21\u5757\u529f\u80fd\u6846\u56fe",
      "style": "Caption"
    },
    {
      "para_index": 15,
      "text": "\u2022 \u6b65\u9aa41\uff1a\u7cfb\u7edf\u542f\u52a8\u540e\u8fdb\u5165\u7b49\u5f85\u5524\u9192\u72b6\u6001\uff0c\u6301\u7eed\u76d1\u542c\u201c\u4f60\u597d\u5c0f\u667a\u201d\u3002",
      "style": "Normal"
    },
    {
      "para_index": 16,
      "text": "\u2022 \u6b65\u9aa42\uff1a\u68c0\u6d4b\u5230\u5524\u9192\u8bcd\u540e\uff0c\u63d0\u793a\u7528\u6237\u8bf4\u51fa\u63a7\u5236\u547d\u4ee4\u3002",
      "style": "Normal"
    },
    {
      "para_index": 17,
      "text": "\u2022 \u6b65\u9aa43\uff1a\u5728\u547d\u4ee4\u7a97\u53e3\u5185\u8bc6\u522b\u4e03\u7c7b\u547d\u4ee4\u53ca\u5176\u540c\u4e49\u8868\u8fbe\u3002",
      "style": "Normal"
    },
    {
      "para_index": 18,
      "text": "\u2022 \u6b65\u9aa44\uff1a\u8bc6\u522b\u6210\u529f\u540e\u8f93\u51fa\u5bf9\u5e94\u6570\u5b57 ID\uff1b\u8d85\u8fc7 6 s \u672a\u8bc6\u522b\u5230\u6709\u6548\u547d\u4ee4\u5219\u5224\u5b9a\u4e3a\u8d85\u65f6\u3002",
      "style": "Normal"
    },
    {
      "para_index": 19,
      "text": "\u2022 \u6b65\u9aa45\uff1a\u6e05\u7406 MultiNet \u72b6\u6001\u5e76\u91cd\u65b0\u542f\u7528 WakeNet\uff0c\u8fd4\u56de\u7b49\u5f85\u5524\u9192\u72b6\u6001\u3002",
      "style": "Normal"
    },
    {
      "para_index": 21,
      "text": "\u56fe 3.X-2  \u79bb\u7ebf\u8bed\u97f3\u8bc6\u522b\u4ea4\u4e92\u6d41\u7a0b\u56fe",
      "style": "Caption"
    },
    {
      "para_index": 32,
      "text": "\u2022 \u6570\u636e\u683c\u5f0f\u8f6c\u6362\uff1aINMP441 \u7684\u6709\u6548 24 \u4f4d\u6709\u7b26\u53f7\u6570\u636e\u4f4d\u4e8e 32 \u4f4d\u91c7\u6837\u7684\u9ad8\u4f4d\uff0c\u7a0b\u5e8f\u5c06\u539f\u59cb\u503c\u7f29\u653e\u4e3a int16_t \u5355\u58f0\u9053 PCM\uff0c\u5e76\u8bbe\u7f6e\u56fa\u5b9a\u6570\u5b57\u589e\u76ca\u3002",
      "style": "Normal"
    },
    {
      "para_index": 33,
      "text": "\u2022 \u9971\u548c\u4fdd\u62a4\uff1a\u8f6c\u6362\u8fc7\u7a0b\u4f7f\u7528 64 \u4f4d\u4e2d\u95f4\u53d8\u91cf\u8ba1\u7b97\uff0c\u7ed3\u679c\u8d85\u8fc7 int16_t \u8303\u56f4\u65f6\u8fdb\u884c\u4e0a\u3001\u4e0b\u9650\u94b3\u4f4d\uff0c\u907f\u514d\u5f3a\u58f0\u97f3\u9020\u6210\u6574\u6570\u6ea2\u51fa\u3002",
      "style": "Normal"
    },
    {
      "para_index": 34,
      "text": "\u2022 \u7f13\u51b2\u533a\u7ba1\u7406\uff1aI2S \u539f\u59cb\u91c7\u6837\u7f13\u51b2\u533a\u4f7f\u7528\u5185\u90e8 DMA \u53ef\u8bbf\u95ee\u5185\u5b58\uff0c\u907f\u514d\u5916\u90e8\u5b58\u50a8\u8bbf\u95ee\u5f71\u54cd\u5b9e\u65f6\u91c7\u96c6\u3002",
      "style": "Normal"
    },
    {
      "para_index": 35,
      "text": "\u2022 \u9ea6\u514b\u98ce\u81ea\u68c0\uff1a\u7a0b\u5e8f\u7d2f\u8ba1\u4e00\u79d2\u97f3\u9891\u6837\u672c\u5e76\u8ba1\u7b97 RMS\uff0c\u901a\u8fc7\u4e32\u53e3\u5468\u671f\u8f93\u51fa\u97f3\u91cf\u503c\uff0c\u7528\u4e8e\u68c0\u67e5\u63a5\u7ebf\u3001\u58f0\u9053\u9009\u62e9\u548c\u9ea6\u514b\u98ce\u5de5\u4f5c\u72b6\u6001\u3002",
      "style": "Normal"
    },
    {
      "para_index": 41,
      "text": "\u2022 \u97f3\u9891\u91c7\u96c6\u4efb\u52a1\uff1a\u56fa\u5b9a\u5728 Core 0\uff0c\u6301\u7eed\u4ece INMP441 \u8bfb\u53d6 PCM \u5e27\u5e76\u8c03\u7528 AFE feed \u63a5\u53e3\u63d0\u4ea4\u97f3\u9891\u3002\u4efb\u52a1\u4f18\u5148\u7ea7\u4e3a 5\uff0c\u6808\u7a7a\u95f4\u4e3a 6 KB\u3002",
      "style": "Normal"
    },
    {
      "para_index": 48,
      "text": "\u2022 \u5efa\u8bae\u9a8c\u6536\u65b9\u6cd5\uff1a\u5206\u522b\u5728\u5b89\u9759\u73af\u5883\u548c\u4e00\u822c\u80cc\u666f\u566a\u58f0\u73af\u5883\u4e0b\u6d4b\u8bd5\u6bcf\u7c7b\u547d\u4ee4\uff0c\u8bb0\u5f55\u6210\u529f\u6b21\u6570\u3001\u8bef\u8bc6\u522b\u6b21\u6570\u3001\u8d85\u65f6\u6b21\u6570\u548c\u5e73\u5747\u54cd\u5e94\u65f6\u95f4\uff0c\u5e76\u636e\u6b64\u8c03\u6574\u9ea6\u514b\u98ce\u589e\u76ca\u3001\u964d\u566a\u914d\u7f6e\u548c\u547d\u4ee4\u77ed\u8bed\u3002",
      "style": "Normal"
    },
    {
      "para_index": 49,
      "text": "\u89c4\u8303\u547d\u4ee4",
      "style": "Normal"
    },
    {
      "para_index": 50,
      "text": "\u6570\u5b57 ID",
      "style": "Normal"
    }
  ],
  "examples": {
    "direct_run_formatting": [
      {
        "para_index": 1,
        "run_text": "3.X \u79bb\u7ebf\u8bed\u97f3\u8bc6\u522b\u529f\u80fd\u8bbe\u8ba1",
        "style": "Heading 1"
      },
      {
        "para_index": 2,
        "run_text": "3.X.1 \u6a21\u5757\u529f\u80fd",
        "style": "Heading 2"
      },
      {
        "para_index": 3,
        "run_text": "\u79bb\u7ebf\u8bed\u97f3\u8bc6\u522b\u6a21\u5757\u662f\u667a\u80fd\u4e50\u8c31\u8f85\u52a9\u7cfb\u7edf\u7684\u4eba\u673a\u4ea4\u4e92\u5b50\u6a21\u5757\uff0c\u91c7\u7528 INMP441 \u6570\u5b57\u9ea6\u514b\u98ce\u91c7\u96c6\u7528\u6237\u8bed\u97f3\uff0c\u5728 ESP32-S3 \u4e0a\u5b8c\u6210\u97f3\u9891\u524d\u7aef\u5904\u7406\u3001\u79bb\u7ebf\u5524\u9192\u548c\u4e2d\u6587\u547d\u4ee4\u8bc6",
        "style": "Normal"
      },
      {
        "para_index": 4,
        "run_text": "3.X.2 \u529f\u80fd\u7ec4\u6210",
        "style": "Heading 2"
      },
      {
        "para_index": 5,
        "run_text": "\u6a21\u5757\u7531\u8bed\u97f3\u91c7\u96c6\u3001\u97f3\u9891\u524d\u7aef\u3001\u5524\u9192\u68c0\u6d4b\u3001\u547d\u4ee4\u8bc6\u522b\u548c\u7ed3\u679c\u8f93\u51fa\u4e94\u4e2a\u90e8\u5206\u7ec4\u6210\uff0c\u5404\u90e8\u5206\u6309\u97f3\u9891\u6570\u636e\u6d41\u987a\u5e8f\u5de5\u4f5c\u3002",
        "style": "Normal"
      }
    ],
    "direct_paragraph_formatting": [
      {
        "para_index": 3,
