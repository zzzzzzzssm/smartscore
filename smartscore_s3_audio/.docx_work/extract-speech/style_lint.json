        "style": "Normal"
      },
      {
        "para_index": 5,
        "text": "\u6a21\u5757\u7531\u8bed\u97f3\u91c7\u96c6\u3001\u97f3\u9891\u524d\u7aef\u3001\u5524\u9192\u68c0\u6d4b\u3001\u547d\u4ee4\u8bc6\u522b\u548c\u7ed3\u679c\u8f93\u51fa\u4e94\u4e2a\u90e8\u5206\u7ec4\u6210\uff0c\u5404\u90e8\u5206\u6309\u97f3\u9891\u6570\u636e\u6d41\u987a\u5e8f\u5de5\u4f5c\u3002",
