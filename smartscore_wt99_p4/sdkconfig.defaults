CONFIG_SMARTSCORE_NETWORK_ONLY=y
CONFIG_SMARTSCORE_WT99_BOARD_REV_1V1=y
CONFIG_SMARTSCORE_WIFI_MAX_RETRIES=5
CONFIG_SMARTSCORE_WIFI_ATTEMPT_TIMEOUT_SECONDS=12
CONFIG_SMARTSCORE_AUTO_CONNECT_SAVED_WIFI=y
# CONFIG_SMARTSCORE_WEB_PROVISIONING_FALLBACK is not set

# Keep logs useful for serial acceptance without enabling verbose packet dumps.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_SMARTSCORE_SPEAKER_ENABLED=y

# The P4 has 16 MiB flash. Keep a single 8 MiB factory app at 0x10000 for the
# lowest-risk migration; audio files live on the external MicroSD card.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The 1024x600 LVGL display uses external PSRAM for draw buffers, generated
# image assets and runtime fonts.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y
CONFIG_ESP32P4_REV_MIN_FULL=0
CONFIG_ESP_REV_MIN_FULL=0

# WT99 display/touch BSP. I2C1 is shared with the existing ES8311 audio
# service by display_board_adapter.
CONFIG_BSP_I2C_NUM=1
CONFIG_BSP_I2C_FAST_MODE=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_BSP_DISPLAY_BRIGHTNESS_LEDC_CH=1

# SD-backed Source Han font support and PSRAM-capable LVGL allocations.
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH="/sdcard/"
CONFIG_LV_FS_STDIO_CACHE_SIZE=4096
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
# CONFIG_LV_USE_TINY_TTF is not set
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y

# Preserve long UTF-8 (including Chinese) WAV file names from the FAT volume.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
