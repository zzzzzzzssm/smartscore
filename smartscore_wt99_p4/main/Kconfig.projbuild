menu "SmartScore WT99 stage-one network firmware"

config SMARTSCORE_NETWORK_ONLY
    bool "Build only the stage-one network firmware"
    default y

config SMARTSCORE_WEB_PROVISIONING_FALLBACK
    bool "Enable SmartScore_Setup web provisioning fallback"
    default n
    help
        BLE is the primary provisioning path. Enable this only when the
        SmartScore_Setup SoftAP fallback is required.

config SMARTSCORE_WIFI_MAX_RETRIES
    int "Maximum Wi-Fi connection attempts"
    range 1 10
    default 5

config SMARTSCORE_WIFI_ATTEMPT_TIMEOUT_SECONDS
    int "Timeout for each Wi-Fi attempt"
    range 3 60
    default 12

config SMARTSCORE_AUTO_CONNECT_SAVED_WIFI
    bool "Automatically connect saved Wi-Fi at startup"
    default y
    help
        When enabled, startup loads valid credentials from smartscore_net
        and tries the saved network with the separate bounded startup policy.
        BLE provisioning remains available when no credentials are saved or
        the bounded connection attempt fails.

config SMARTSCORE_SAVED_WIFI_MAX_ATTEMPTS
    int "Maximum saved Wi-Fi connection attempts at startup"
    range 1 20
    default 10
    help
        Caps how many times startup may trigger a connection to the saved
        network. The total startup timeout can end this loop earlier.

config SMARTSCORE_SAVED_WIFI_TOTAL_TIMEOUT_SECONDS
    int "Total saved Wi-Fi startup timeout"
    range 1 30
    default 5
    help
        Hard time budget for all saved-network connection attempts at boot.
        This does not change the timeout used after BLE or web provisioning.

endmenu
