.music-page { width:100%; overflow-x:hidden; padding-bottom:170rpx; }
.music-hero { padding: 34rpx 30rpx; border-radius: 26rpx; color: #fff; background: linear-gradient(135deg,#1d4ed8 0%,#0ea5a4 100%); box-shadow: 0 18rpx 40rpx rgba(29,78,216,.2); }
.hero-row, .section-head, .control-row, .file-info, .pagination { display: flex; align-items: center; }
.hero-row, .section-head { justify-content: space-between; }
.hero-kicker { margin-bottom: 8rpx; color: rgba(255,255,255,.7); font-size: 21rpx; font-weight: 800; letter-spacing: 3rpx; }
.hero-title { font-size: 46rpx; font-weight: 850; }
.hero-subtitle { margin-top: 10rpx; color: rgba(255,255,255,.84); font-size: 25rpx; }
.hero-status { display: inline-block; margin-top: 22rpx; padding: 9rpx 17rpx; border-radius: 999rpx; background: rgba(255,255,255,.16); font-size: 22rpx; }
.online-dot { width: 22rpx; height: 22rpx; border: 7rpx solid rgba(255,255,255,.24); border-radius: 50%; background:#94a3b8; }
.online-dot.on { background:#86efac; box-shadow:0 0 20rpx rgba(134,239,172,.9); }
.offline-card { margin-top:20rpx; padding:28rpx; border:1rpx solid #f5d7a7; border-radius:20rpx; background:#fffbeb; text-align:left; box-shadow:0 12rpx 32rpx rgba(23,32,51,.06); }
.offline-title { margin-bottom:8rpx; color:#92400e; font-size:30rpx; font-weight:800; }
.offline-card button { width:220rpx; min-height:64rpx; margin:20rpx 0 0; padding:0 20rpx; font-size:25rpx; line-height:64rpx; }
.card-title { font-size:32rpx; font-weight:800; }
.import-card { padding:24rpx; }
.import-card .row { gap:20rpx; }
.import-hint { max-width:470rpx; margin-top:8rpx; line-height:1.6; }
.import-btn { flex:none; width:190rpx; min-height:70rpx; margin:0; padding:0 18rpx; font-size:25rpx; line-height:70rpx; }
.import-progress { margin-top:22rpx; }
.import-progress-copy { margin-bottom:10rpx; color:#0f766e; font-size:23rpx; font-weight:700; }
.import-progress .hint { margin-top:10rpx; }
.volume-card { padding-top:22rpx; padding-bottom:22rpx; }
.volume-card slider { margin:18rpx 0 8rpx; }
.volume-value { color:#0f766e; font-size:46rpx; font-weight:900; }
.control-row { gap:16rpx; margin-top:14rpx; }
.control-btn { flex:1; min-width:0; min-height:66rpx; padding:0 10rpx; font-size:28rpx; line-height:66rpx; }
.stop-btn { border-radius:16rpx; color:#b42318; background:#fff1f0; font-weight:700; }
.section-title.compact { margin:0; font-size:32rpx; }
.refresh-btn { display:flex; align-items:center; justify-content:center; flex:0 0 116rpx; width:116rpx; min-width:0; min-height:58rpx; padding:0; border-radius:14rpx; color:#0f766e; background:#e8f7f5; box-sizing:border-box; font-size:23rpx; line-height:1; }
.search-card { display:flex; align-items:center; gap:10rpx; overflow:hidden; margin-top:18rpx; padding:14rpx; border:1rpx solid #d7e7e6; border-radius:18rpx; background:#fff; box-sizing:border-box; }
.search-input { flex:1; min-width:0; height:66rpx; padding:0 18rpx; border-radius:13rpx; background:#f3f8f8; font-size:25rpx; }
.search-btn, .clear-btn { display:flex; align-items:center; justify-content:center; flex:none; min-width:0; min-height:66rpx; padding:0; border-radius:13rpx; box-sizing:border-box; font-size:23rpx; line-height:1; }
.search-btn { width:108rpx; }
.clear-btn { width:88rpx; }
.search-btn { color:#fff; background:#0f766e; }
.clear-btn { color:#475467; background:#eef3f3; }
.sd-state { display:inline-block; margin-top:16rpx; padding:10rpx 15rpx; border-radius:999rpx; color:#b45309; background:#fff7ed; font-size:22rpx; }
.sd-state.ready { color:#0f766e; background:#e8f7f5; }
.result-summary { float:right; margin-top:25rpx; color:#667085; font-size:23rpx; }
.file-list { clear:both; margin-top:16rpx; padding-top:4rpx; }
.file-item { display:flex; align-items:center; gap:14rpx; min-height:100rpx; padding:14rpx 0; border-bottom:1rpx solid #edf2f2; }
.file-item.active { color:#0f766e; }
.file-info { flex:1; min-width:0; gap:15rpx; }
.file-icon { display:flex; align-items:center; justify-content:center; flex:none; width:58rpx; height:58rpx; border-radius:15rpx; color:#1d4ed8; background:#eaf2ff; font-size:28rpx; }
.file-copy { flex:1; min-width:0; }
.file-name { overflow:hidden; font-size:25rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
.playing-label { margin-top:4rpx; color:#0f766e; font-size:20rpx; }
.file-play { display:flex; align-items:center; justify-content:center; flex:0 0 124rpx; width:124rpx; min-width:0; min-height:54rpx; padding:0; border-radius:999rpx; color:#0f766e; background:#f3f8f8; box-sizing:border-box; font-size:22rpx; line-height:1; }
.pagination { display:flex; align-items:stretch; gap:12rpx; width:100%; min-width:0; margin-top:20rpx; box-sizing:border-box; }
.page-btn { display:flex; align-items:center; justify-content:center; flex:1 1 0; width:0; min-width:0; min-height:58rpx; padding:0; border-radius:14rpx; color:#0f766e; background:#e8f7f5; box-sizing:border-box; font-size:23rpx; line-height:1; }
.page-number { display:flex; align-items:center; justify-content:center; flex:0 0 112rpx; width:112rpx; color:#667085; font-size:22rpx; text-align:center; white-space:nowrap; }
.page-number text { color:#172033; font-size:30rpx; font-weight:850; }
.now-playing { position:fixed; right:28rpx; bottom:30rpx; left:28rpx; z-index:20; display:flex; align-items:center; padding:18rpx 20rpx; border-radius:22rpx; color:#fff; background:rgba(15,36,45,.95); box-shadow:0 18rpx 50rpx rgba(15,36,45,.28); opacity:0; pointer-events:none; transform:translateY(30rpx); transition:.2s; }
.now-playing.visible { opacity:1; pointer-events:auto; transform:translateY(0); }
.now-icon { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:17rpx; background:#1d4ed8; font-size:30rpx; }
.now-copy { flex:1; min-width:0; margin-left:17rpx; }
.now-label { color:rgba(255,255,255,.58); font-size:20rpx; }
.now-title { overflow:hidden; margin-top:3rpx; font-size:24rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.now-stop { display:flex; align-items:center; justify-content:center; flex:0 0 112rpx; width:112rpx; min-width:0; min-height:56rpx; padding:0; border-radius:999rpx; color:#fff; background:rgba(255,255,255,.14); box-sizing:border-box; font-size:22rpx; line-height:1; }
.disabled { opacity:.42; pointer-events:none; }
.control-hover { opacity:.72; }
